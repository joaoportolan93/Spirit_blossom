# =============================================================================
# Variáveis de ambiente — preencha e salve como .env (nunca comite .env)
# =============================================================================

# --- Produto ---
APP_NAME=
VITE_APP_NAME=

# --- Django ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Banco de dados ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Upload / Media ---
MEDIA_ROOT=/app/media
MAX_UPLOAD_MB=10

# --- Posts ---
POST_MAX_CHARS=3000

# --- Feed ---
FEED_FRESHNESS_HALFLIFE_HOURS=48
FEED_DEFAULT_LIMIT=20

# --- Serviço de feed (Rust) ---
FEED_SERVICE_URL=http://feed:3000

# --- Infra ---
BACKEND_PORT=8000


# --- Seguran�a AccessLog (Marco Civil) ---
ACCESS_LOG_HMAC_KEY=gere-uma-chave-aleatoria-de-32-bytes-aqui!
