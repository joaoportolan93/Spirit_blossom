msgid "[%(app_name)s] Password reset"
msgstr "[%(app_name)s] Recuperação de senha"

msgid ""
"Hello %(username)s,\n"
"\n"
"You requested a password reset on %(app_name)s.\n"
"Access the link below within 15 minutes to set a new password:\n"
"\n"
"%(reset_url)s\n"
"\n"
"If you did not request this, no action is needed."
msgstr ""
"Olá %(username)s,\n"
"\n"
"Você solicitou a recuperação da sua senha na %(app_name)s.\n"
"Acesse o link abaixo em até 15 minutos para definir uma nova senha:\n"
"\n"
"%(reset_url)s\n"
"\n"
"Se você não solicitou, nenhuma ação é necessária."

