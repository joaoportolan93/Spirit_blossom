msgid "[%(app_name)s] Password reset"
msgstr "[%(app_name)s] Password reset"

msgid ""
"Hello %(username)s,\n"
"\n"
"You requested a password reset on %(app_name)s.\n"
"Access the link below within 15 minutes to set a new password:\n"
"\n"
"%(reset_url)s\n"
"\n"
"If you did not request this, no action is needed."
msgstr ""
"Hello %(username)s,\n"
"\n"
"You requested a password reset on %(app_name)s.\n"
"Access the link below within 15 minutes to set a new password:\n"
"\n"
"%(reset_url)s\n"
"\n"
"If you did not request this, no action is needed."

