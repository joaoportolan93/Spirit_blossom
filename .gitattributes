# Força LF no repositório para todos os arquivos de texto.
# Git converte para CRLF no checkout em Windows se core.autocrlf=true,
# mas o repositório sempre guarda LF. Isso elimina os warnings.

* text=auto eol=lf

# Forçar LF explicitamente por tipo
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.rs    text eol=lf
*.sh    text eol=lf
*.conf  text eol=lf
*.ini   text eol=lf
*.env*  text eol=lf
Dockerfile* text eol=lf

# Binários — sem conversão
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary

